includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 8

    paths:
        - examples/
        - src/
        - tests/
        - v1-compat/

    scanDirectories:
        - vendor

    treatPhpDocTypesAsCertain: false

    # PHPUnit 9.6 (PHP 8.0 and 8.1) does not know the attribute classes. The tests
    # use attributes and doc-comments side by side to support all PHPUnit versions.
    # Behat 3.15 (PHP 8.0) has no hook attributes, but Behat only runs on PHP 8.4.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            identifier: attribute.notFound
            message: '#^Attribute class (PHPUnit\\Framework\\Attributes\\DataProvider|Behat\\Hook\\(Before|After)Suite) does not exist\.$#'
            path: tests/
